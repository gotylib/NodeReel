# Copy to .env.app and fill in. Used by: docker compose -f docker-compose.app.yml --env-file .env.app up -d

# Docker network shared with your existing postgres/minio containers (Dokploy project network name)
EXTERNAL_NETWORK=dokploy-network

# Postgres (service hostname inside EXTERNAL_NETWORK)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nodereel
POSTGRES_USER=nodereel
POSTGRES_PASSWORD=change-me

# MinIO S3 API (hostname:port inside EXTERNAL_NETWORK — not the console port)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=nodereel
MINIO_USE_SSL=false

# Auth
AUTH_JWT_KEY=change-me-to-a-long-random-secret-32chars
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=change-me

# Published ports on the host (optional)
API_PORT=5057
FRONTEND_PORT=8080

# Frontend → API (usually leave as compose service name)
API_UPSTREAM=http://api:8080
