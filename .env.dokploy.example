# Dokploy: two applications (Frontend + Backend). Postgres/MinIO already deployed.
# Put both apps in the SAME Dokploy project (shared Docker network).

# =============================================================================
# BACKEND  — Build Path: /backend  |  Container port: 8080
# =============================================================================
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Internal hostname of your Postgres service (not localhost)
ConnectionStrings__Default=Host=postgres;Port=5432;Database=nodereel;Username=nodereel;Password=YOUR_PASSWORD

# MinIO S3 API host:port (NOT console). Create bucket "nodereel" beforehand.
Minio__Endpoint=minio:9000
Minio__AccessKey=minioadmin
Minio__SecretKey=YOUR_MINIO_SECRET
Minio__Bucket=nodereel
Minio__UseSsl=false

Ffmpeg__BinaryPath=ffmpeg

Auth__JwtKey=CHANGE_ME_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
Auth__JwtIssuer=NodeReel
Auth__JwtAudience=NodeReel
Auth__TokenLifetimeHours=72
Auth__AdminUsername=admin
Auth__AdminPassword=CHANGE_ME

# =============================================================================
# FRONTEND — Build Path: /frontend  |  Container port: 80
# =============================================================================
# Internal URL of the BACKEND container (Dokploy service/container name + port 8080).
# No trailing slash. Example if backend app is named "nodereel-api":
#   API_UPSTREAM=http://nodereel-api:8080
API_UPSTREAM=http://YOUR_BACKEND_SERVICE_NAME:8080
